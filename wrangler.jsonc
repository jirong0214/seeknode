{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seeknode",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-18",
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // 环境变量在生产环境中通过 wrangler secret 设置
  // 本地开发使用 .dev.vars 文件
  // "vars": {
  //   "BOT_TOKEN": "YOUR_ACTUAL_BOT_TOKEN_HERE",
  //   "START_COMMAND": "start"
  // },
  // 定时任务：RSS监控每5分钟运行；每天清理一次过期数据
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "17 3 * * *"
    ]
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",  
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // D1数据库配置
  // 生产环境数据库配置在这里
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seeknode",
      "database_id": "107db7fd-b7d0-4500-8e0a-cf50249b739b"
    }
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
