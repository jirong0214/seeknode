{
  "name": "seeknode",
  "scripts": {
    "dev": "wrangler dev",
    "dev:config": "wrangler dev --config wrangler.dev.jsonc",
    "deploy": "wrangler deploy --minify",
    "deploy:staging": "wrangler deploy --config wrangler.staging.jsonc --minify",
    "deploy:prod": "wrangler deploy --config wrangler.prod.jsonc --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:create": "wrangler d1 create seeknode",
    "db:migrate": "wrangler d1 migrations apply seeknode --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "grammy": "^1.21.1",
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.4.0"
  }
}
